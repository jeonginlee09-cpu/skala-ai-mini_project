OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RELEVANCE_MODEL=gpt-4o
# Optional semantic Reviewer, called only for complex grounded questions.
REVIEWER_MODE=conditional
OPENAI_REVIEWER_MODEL=gpt-4o
# OpenAI backend defaults to chroma; fake/ollama default to off.
# RUNBOOK_SEARCH_MODE=chroma

# Optional tracing. Never commit the real .env file.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=capstone-rag-grounding-openai
