{
  "version": 1,
  "note": "수업 런북 6개를 기준으로 사람이 검토할 수 있게 작성한 조건표입니다. 실제 운영 임계값의 타당성을 입증하지 않습니다. 원문 해시가 달라지면 적용하지 않습니다.",
  "runbooks": {
    "cpu-spike": {
      "content_hash": "30796f7b5c1d0bc09acfb2518b240e3a07b04136e84fe41397802a3bf2bff22d",
      "steps": [
        {
          "step_id": 1,
          "text": "get_monitoring_status로 CPU 사용률과 최근 배포/트래픽 변화 시점을 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "반복 호출, 배치 작업 중복 실행 같은 특정 요청 패턴이 원인인지 최근 로그에서 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 3,
          "text": "CPU가 90%를 넘고 지속되면 해당 인스턴스를 오토스케일링 그룹에서 한 대 더 띄워 부하를 분산한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "cpu_percent",
              "op": "gt",
              "value": 90,
              "label": "CPU 사용률 90% 초과"
            },
            {
              "field": "cpu_sustained",
              "op": "is_true",
              "value": true,
              "label": "CPU가 높은 상태로 지속되는지"
            }
          ]
        },
        {
          "step_id": 4,
          "text": "급증이 특정 배포 직후 시작됐다면 직전 배포를 롤백하고 원인 분석은 별도로 진행한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "spike_after_deploy",
              "op": "is_true",
              "value": true,
              "label": "급증이 특정 배포 직후 시작됐는지"
            }
          ]
        },
        {
          "step_id": 5,
          "text": "정상화 후 프로파일링 결과를 바탕으로 핫스팟 코드를 식별해 최적화 작업을 등록한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "service_recovered",
              "op": "is_true",
              "value": true,
              "label": "서비스 정상화 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "request_pattern",
          "text": "반복 호출 또는 배치 작업 중복 실행"
        },
        {
          "id": "deployment_effect",
          "text": "최근 배포의 영향"
        }
      ]
    },
    "memory-leak": {
      "content_hash": "085f00e9bba5effbb54e97a82d5f0b7032e027dac29816021729932a5e9a9ee1",
      "steps": [
        {
          "step_id": 1,
          "text": "get_monitoring_status로 메모리 사용률 추세(시간에 따라 꾸준히 증가하는지)를 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "OOM 직전(90% 이상)이면 해당 프로세스를 즉시 재시작해 서비스 중단을 막는다 — 재시작은 임시 조치일 뿐임을 기록해둔다.",
          "kind": "action",
          "conditions": [
            {
              "field": "memory_percent",
              "op": "ge",
              "value": 90,
              "label": "메모리 사용률 90% 이상"
            }
          ]
        },
        {
          "step_id": 3,
          "text": "힙 덤프 또는 프로파일링 도구로 어떤 객체가 계속 쌓이는지 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 4,
          "text": "캐시 무제한 증가, 커넥션 미반환, 이벤트 리스너 중복 등록 같은 패턴이 최근 배포에 있었는지 점검한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 5,
          "text": "원인이 된 배포가 있으면 롤백하고, 컨테이너 메모리 상한선을 재확인해 재발 시 더 빨리 감지되도록 조정한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "deployment_caused_issue",
              "op": "is_true",
              "value": true,
              "label": "특정 배포가 원인인지 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "object_accumulation",
          "text": "캐시 무제한 증가·객체 누적 또는 자원 미반환"
        }
      ]
    },
    "high-latency": {
      "content_hash": "0df4846e66993b0b9312327a3f51fe6de663d701c64c2c7c10a9e2c35e9e63a3",
      "steps": [
        {
          "step_id": 1,
          "text": "get_monitoring_status로 p95 지연시간과 커넥션 풀 사용률을 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "커넥션 풀 사용률이 90%를 넘으면 풀 크기를 늘리거나 느린 쿼리/외부 호출에 타임아웃을 건다.",
          "kind": "action",
          "conditions": [
            {
              "field": "pool_percent",
              "op": "gt",
              "value": 90,
              "label": "현재 커넥션 풀 사용률 90% 초과"
            }
          ]
        },
        {
          "step_id": 3,
          "text": "지연이 특정 리전/인스턴스에 몰려 있으면 해당 인스턴스를 로드밸런서에서 일시 제외한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "region_concentration",
              "op": "is_true",
              "value": true,
              "label": "지연의 특정 리전·인스턴스 집중"
            }
          ]
        },
        {
          "step_id": 4,
          "text": "5분 내 p95가 임계치(1.0s) 아래로 내려오지 않으면 캐시 계층 또는 읽기 복제본으로 트래픽을 분산한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "p95_not_recovered_after_5m",
              "op": "is_true",
              "value": true,
              "label": "5분 안에 p95가 임계치 아래로 회복되지 않았는지"
            }
          ]
        },
        {
          "step_id": 5,
          "text": "정상화 후 느린 쿼리 로그를 분석해 근본 원인을 문서화하고 후속 최적화 티켓을 등록한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "service_recovered",
              "op": "is_true",
              "value": true,
              "label": "서비스 정상화 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "pool_saturation",
          "text": "커넥션 풀 포화 또는 느린 쿼리·외부 호출의 영향"
        }
      ]
    },
    "network-timeout": {
      "content_hash": "ed68d1bc775138e7e66cfb50698949856bf27d5e11afefff6e5826223e063596",
      "steps": [
        {
          "step_id": 1,
          "text": "get_monitoring_status로 어떤 시스템 간 호출에서 타임아웃이 발생하는지 확인한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "DNS 해석 실패, 방화벽/보안그룹 변경, 로드밸런서 헬스체크 실패 중 최근 변경 사항이 있었는지 점검한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 3,
          "text": "특정 리전/가용영역에서만 발생하면 해당 구간을 우회하는 라우팅으로 임시 전환한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "region_only_failure",
              "op": "is_true",
              "value": true,
              "label": "특정 리전·가용영역에서만 발생"
            }
          ]
        },
        {
          "step_id": 4,
          "text": "타임아웃 값이 너무 짧아 정상 응답도 실패로 처리되는 경우라면 임계값을 임시 상향해 2차 피해를 줄인다.",
          "kind": "action",
          "conditions": [
            {
              "field": "timeout_too_short",
              "op": "is_true",
              "value": true,
              "label": "타임아웃 값이 너무 짧아 정상 응답도 실패하는지"
            }
          ]
        },
        {
          "step_id": 5,
          "text": "정상화 후 네트워크 경로 기록을 남기고, 재발 방지를 위해 헬스체크 주기와 재시도 정책을 재검토한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "service_recovered",
              "op": "is_true",
              "value": true,
              "label": "서비스 정상화 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "network_change",
          "text": "DNS·방화벽·보안그룹 또는 로드밸런서 헬스체크 변경"
        }
      ]
    },
    "disk-full": {
      "content_hash": "72b9d4f006490887ccba981531129e5a42c0d7b8c789208db391fdc5acc566c7",
      "steps": [
        {
          "step_id": 1,
          "text": "get_monitoring_status와 서버 디스크 사용률을 확인해 임계 수준(90% 이상)인지 판단한다.",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "로그 파일, 임시 파일, 오래된 백업처럼 안전하게 지울 수 있는 항목부터 정리해 여유 공간을 즉시 확보한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "disk_percent",
              "op": "ge",
              "value": 90,
              "label": "현재 디스크 사용률 90% 이상"
            }
          ]
        },
        {
          "step_id": 3,
          "text": "특정 프로세스가 비정상적으로 로그를 쌓고 있다면 로그 레벨을 낮추거나 로테이션 주기를 단축한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "abnormal_log_growth",
              "op": "is_true",
              "value": true,
              "label": "특정 프로세스가 비정상 로그를 쌓는지"
            }
          ]
        },
        {
          "step_id": 4,
          "text": "임시 조치로도 부족하면 볼륨을 확장하거나 추가 스토리지를 연결한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "cleanup_insufficient",
              "op": "is_true",
              "value": true,
              "label": "임시 조치 후에도 공간이 부족한지"
            }
          ]
        },
        {
          "step_id": 5,
          "text": "정상화 후 로그 보존 정책과 디스크 사용률 알림 임계값을 재검토해 조기에 감지되도록 조정한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "service_recovered",
              "op": "is_true",
              "value": true,
              "label": "서비스 정상화 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "log_growth",
          "text": "특정 프로세스의 비정상적인 로그 누적"
        }
      ]
    },
    "db-down": {
      "content_hash": "a2d4f4d3bc89984348976e9012518ceba32f389a35bf5ee7da4c19f7e1de9be5",
      "steps": [
        {
          "step_id": 1,
          "text": "모니터링 알람으로 장애를 즉시 인지한다 (get_monitoring_status로 현재 상태 확인).",
          "kind": "check",
          "conditions": []
        },
        {
          "step_id": 2,
          "text": "커넥션 풀/리플리케이션 상태를 점검하고 필요 시 failover 노드로 전환한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "failover_needed",
              "op": "is_true",
              "value": true,
              "label": "상태 점검 후 failover가 필요한지"
            }
          ]
        },
        {
          "step_id": 3,
          "text": "서비스 정상화 확인 후 원인 분석과 재발 방지 대책을 문서화한다.",
          "kind": "action",
          "conditions": [
            {
              "field": "service_recovered",
              "op": "is_true",
              "value": true,
              "label": "서비스 정상화 확인"
            }
          ]
        }
      ],
      "hypotheses": [
        {
          "id": "connection_replication",
          "text": "데이터베이스 커넥션 풀 또는 리플리케이션 문제"
        }
      ]
    }
  }
}